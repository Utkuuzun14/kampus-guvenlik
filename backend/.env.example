# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env git'e girmez.

# MQTT broker ayarları
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_KULLANICI=
MQTT_PAROLA=

# E-posta bildirim ayarları (Gmail: SMTP_PAROLA = 16 haneli uygulama şifresi)
SMTP_SUNUCU=smtp.gmail.com
SMTP_PORT=465
SMTP_KULLANICI=
SMTP_PAROLA=
BILDIRIM_ALICI=
BILDIRIM_AKTIF=true
BILDIRIM_SEVIYELER=kritik,yuksek
BILDIRIM_BEKLEME_SN=300

# Akıllı kurallar
# Yangın teyidi: duman alarmı + alev bu kadar saniye içinde gelirse "yangin_teyit" olayı
KORELASYON_PENCERE_SN=10
# Güvenlik modu "otomatik"ken hareket seviyesi sunucu saatine göre (Europe/Istanbul):
# hafta içi mesai → bilgi, gece aralığı (her gün) → yuksek, kalanı → orta
MESAI_BASLANGIC=08:00
MESAI_BITIS=18:00
GECE_BASLANGIC=23:00
GECE_BITIS=06:00

# Kimlik doğrulama
# JWT imza anahtarı: uzun rastgele bir değer üretip yazın, ör.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Boşsa backend her açılışta rastgele üretir ve yeniden başlayınca oturumlar düşer.
JWT_GIZLI_ANAHTAR=
# Oturum (token) süresi, saat
TOKEN_SURE_SAAT=8
# Panelin açıldığı adresler (CORS, virgülle). Boşsa localhost/127.0.0.1 :5173 ve :5174
CORS_KAYNAKLAR=

# senaryo.py --mod için API girişi (admin rolünde bir kullanıcı)
SENARYO_KULLANICI=
SENARYO_PAROLA=
